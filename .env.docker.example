# Beispiel-Einstellungen für Docker Compose.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d
#
# .env.docker enthält Passwörter und ist per .gitignore ausgeschlossen – nie
# einchecken. Die Datei .env im Projektordner bleibt der Entwicklung vorbehalten.

# --- Image -------------------------------------------------------------------

# Version des Images aus https://github.com/TheAkki/Hausverwaltung/pkgs/container/hausverwaltung
# Empfohlen: eine feste Version (z. B. v1.0.0) statt latest – dann ändert sich nichts
# ungeplant. "edge" ist der aktuelle Entwicklungsstand (nur zum Testen).
HV_VERSION=latest
# HV_IMAGE=ghcr.io/theakki/hausverwaltung

# --- Anwendung ---------------------------------------------------------------

APP_NAME=Hausverwaltung
# Adresse, unter der die Anwendung im Browser erreichbar ist
APP_URL=http://localhost:8080
# Port auf dem Docker-Host
APP_PORT=8080
APP_LOCALE=de

# Pflicht: E-Mail-Adresse des Administrators. Nur er darf Benutzer und Gruppen
# für andere anlegen.
ADMIN_EMAIL=

# Leer lassen: beim ersten Start wird ein Schlüssel erzeugt und im storage-Volume
# gespeichert. Wer ihn selbst verwaltet: "docker compose run --rm app php artisan
# key:generate --show" und den Wert hier eintragen.
APP_KEY=

# Hinter HTTPS (Reverse Proxy) auf true setzen
SESSION_SECURE_COOKIE=false
LOG_LEVEL=warning

# --- Datenbank ---------------------------------------------------------------
#
# Genau eine der folgenden Varianten verwenden.

# a) SQLite (Standard): keine weiteren Angaben nötig. Die Datenbank liegt im
#    storage-Volume. Optional ein anderer absoluter Pfad im Container:
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/storage/app/database.sqlite

# b) MySQL/MariaDB
#    Mit mitgeliefertem MariaDB-Container: COMPOSE_PROFILES=mariadb und
#    DB_HOST=mariadb. Für einen vorhandenen Server COMPOSE_PROFILES leer lassen
#    und DB_HOST auf dessen Adresse setzen.
# COMPOSE_PROFILES=mariadb
# DB_CONNECTION=mariadb        # oder mysql für einen MySQL-Server
# DB_HOST=mariadb
# DB_PORT=3306
# DB_DATABASE=hausverwaltung
# DB_USERNAME=hausverwaltung
# DB_PASSWORD=
# DB_ROOT_PASSWORD=            # nur für den mitgelieferten MariaDB-Container

# c) PostgreSQL
#    Mit mitgeliefertem Container: COMPOSE_PROFILES=postgres und DB_HOST=postgres.
#    Für einen vorhandenen Server COMPOSE_PROFILES leer lassen und DB_HOST setzen.
# COMPOSE_PROFILES=postgres
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=hausverwaltung
# DB_USERNAME=hausverwaltung
# DB_PASSWORD=
# DB_SSLMODE=prefer            # disable, prefer, require, verify-full

# Wie lange beim Start auf den Datenbankserver gewartet wird (Sekunden)
DB_WAIT_TIMEOUT=60

# --- E-Mail (z. B. für „Passwort vergessen“) ----------------------------------
#
# Standard "log": Mails landen nur im Log. Für echten Versand smtp eintragen.
MAIL_MAILER=log
# MAIL_HOST=smtp.example.org
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=hausverwaltung@example.org
